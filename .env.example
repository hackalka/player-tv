# ===== Variables de entorno de Tv Player =====
# Copia este archivo como .env para desarrollo local, o ponlas en Railway (Variables).

# Credenciales de la API de Telegram (https://my.telegram.org)
TG_API_ID=8952741
TG_API_HASH=693fb2da124662dad85b2b337c53a386

# Sesión de usuario generada con `npm run login` (cadena larga). NO la subas a GitHub.
TG_SESSION=

# Grupo/foro de origen (formato -100xxxxxxxxxx)
TG_GROUP_ID=-1003924237464

# Nombre de la app (marca que se ve arriba a la izquierda)
APP_NAME=Tv Player

# Cuántos mensajes traer por tema
MESSAGES_PER_TOPIC=80

# Puerto (en Railway se inyecta automáticamente; en local usa 3000)
PORT=3000
