# ===== Variables de entorno de Tv Player =====
# Copia este archivo como .env para desarrollo local, o ponlas en Railway (Variables).

# Credenciales de la API de Telegram (https://my.telegram.org)
TG_API_ID=8952741
TG_API_HASH=693fb2da124662dad85b2b337c53a386

# Sesión de usuario generada con `npm run login` (cadena larga). NO la subas a GitHub.
TG_SESSION=

# Grupo/foro de origen (formato -100xxxxxxxxxx, o @usuario si es público)
TG_GROUP_ID=-1003749684388

# Nombre de la app (marca que se ve arriba a la izquierda)
APP_NAME=Tv Player

# Contraseña de administrador (para ver el chat y editar/borrar contenido desde la web).
# Déjala vacía si no quieres panel de administración.
ADMIN_PASSWORD=

# Cuántos mensajes traer por tema
MESSAGES_PER_TOPIC=80

# Etiqueta(s) que debe tener el TÍTULO de un tema para mostrarse en la web.
# Se pueden poner varias separadas por coma. El nombre se muestra SIN la etiqueta.
# Ej.: tema "Películas playertv:auto" -> se ve como "Películas".
AUTO_TAG=playertv:auto,tvplayer:auto

# Puerto (en Railway se inyecta automáticamente; en local usa 3000)
PORT=3000
