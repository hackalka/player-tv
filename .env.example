# ===== Variables de entorno de Tv Player (multi-usuario) =====
# Copialo como .env en local, o ponlas en el panel de tu plataforma
# (Koyeb: Service > Settings > Environment variables).

# Credenciales de la API de Telegram (https://my.telegram.org) - compartidas por la app
TG_API_ID=
TG_API_HASH=

# Grupo/foro de origen (formato -100xxxxxxxxxx, o @usuario si es publico)
TG_GROUP_ID=

# Nombre de la app (marca de arriba a la izquierda)
APP_NAME=Tv Player

# Etiqueta(s) que debe tener el TITULO de un tema para mostrarse (separadas por coma)
AUTO_TAG=playertv:auto,tvplayer:auto

# Mensajes a traer por tema
MESSAGES_PER_TOPIC=80

# TMDB: rellena sinopsis, anio, nota, generos y caratula. Usa v4 token (recomendado) o v3 key.
TMDB_TOKEN=
# TMDB_KEY=

# Puerto. Koyeb/Railway lo inyectan solos; en local usa 3000.
PORT=3000

# ===== Persistencia de sesiones =====
# RECOMENDADO en Koyeb/Render free (disco efimero): URL de un Postgres gratis.
# Si la defines, los logins sobreviven a los redeploys. Si la dejas vacia,
# se guardan en un fichero dentro de DATA_DIR (se pierden si el disco no persiste).
DATABASE_URL=

# (Opcional) carpeta de datos cuando usas un disco persistente (Railway Volume, etc.)
# DATA_DIR=/data

# Nota:
#  - Cada usuario inicia sesion con su propia cuenta (telefono + 2FA) en la web.
#  - "Admin" = quien sea administrador/creador del grupo en Telegram (automatico).
