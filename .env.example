# ===== Variables de entorno de Tv Player (multi-usuario) =====
# Cópialo como .env en local, o ponlas en Railway (Variables).

# Credenciales de la API de Telegram (https://my.telegram.org) — compartidas por la app
TG_API_ID=8952741
TG_API_HASH=693fb2da124662dad85b2b337c53a386

# Grupo/foro de origen (formato -100xxxxxxxxxx, o @usuario si es público)
TG_GROUP_ID=-1003749684388

# Nombre de la app (marca de arriba a la izquierda)
APP_NAME=Tv Player

# Etiqueta(s) que debe tener el TÍTULO de un tema para mostrarse (separadas por coma)
AUTO_TAG=playertv:auto,tvplayer:auto

# Mensajes a traer por tema
MESSAGES_PER_TOPIC=80

# Puerto (Railway lo inyecta solo; en local usa 3000)
PORT=3000

# (Opcional) carpeta donde se guardan las sesiones de usuario y la caché.
# Por defecto usa una carpeta temporal del sistema.
# DATA_DIR=/data

# Ya NO se usan TG_SESSION ni ADMIN_PASSWORD:
#  - Cada usuario inicia sesión con su propia cuenta (teléfono + 2FA) en la web.
#  - "Admin" = quien sea administrador/creador del grupo en Telegram (automático).
